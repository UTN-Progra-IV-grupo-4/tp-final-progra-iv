{
  "realm": "seat-reservation",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "users": [
    {
      "username": "user1",
      "enabled": true,
      "emailVerified": true,
      "email": "user1@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "User123!",
          "temporary": false
        }
      ],
      "realmRoles": ["user"],
      "clientRoles": {
        "account": ["view-profile", "manage-account"]
      }
    },
    {
      "username": "user2",
      "enabled": true,
      "emailVerified": true,
      "email": "user2@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "User123!",
          "temporary": false
        }
      ],
      "realmRoles": ["user"],
      "clientRoles": {
        "account": ["view-profile", "manage-account"]
      }
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Regular user for seat reservations"
      },
      {
        "name": "admin",
        "description": "Administrator user with elevated permissions"
      }
    ]
  },
  "clients": [
    {
      "clientId": "availability-web",
      "name": "Availability Web",
      "enabled": true,
      "publicClient": true,
      "redirectUris": [
        "http://localhost:5212/signin-oidc",
        "https://localhost:7057/signin-oidc"
      ],
      "webOrigins": [
        "http://localhost:5212",
        "https://localhost:7057"
      ],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+http://localhost:5212,+https://localhost:7057"
      },
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "name",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "name",
            "jsonType.label": "String"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "email",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "booking-service",
      "name": "Booking Service",
      "enabled": true,
      "publicClient": false,
      "secret": "${KEYCLOAK_BOOKING_CLIENT_SECRET}",
      "redirectUris": [],
      "webOrigins": [],
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "3600"
      },
      "protocolMappers": [
        {
          "name": "payment-service-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "payment-service",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": ["web-origins", "roles", "profile", "email"]
    },
    {
      "clientId": "payment-service",
      "name": "Payment Service",
      "enabled": true,
      "publicClient": false,
      "secret": "${KEYCLOAK_PAYMENT_CLIENT_SECRET}",
      "redirectUris": [],
      "webOrigins": [],
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "3600"
      },
      "protocolMappers": [],
      "defaultClientScopes": ["web-origins", "roles", "profile", "email"]
    },
    {
      "clientId": "availability-service",
      "name": "Availability Service",
      "enabled": true,
      "publicClient": false,
      "secret": "${KEYCLOAK_AVAILABILITY_CLIENT_SECRET}",
      "redirectUris": [],
      "webOrigins": [],
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "3600"
      },
      "protocolMappers": [
        {
          "name": "booking-service-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "booking-service",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": ["web-origins", "roles", "profile", "email"]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "providerId": "google",
      "enabled": true,
      "updateProfileFirstLoginMode": "on",
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstLoginFlowAlias": "auto-link",
      "config": {
        "useJwksUrl": "true",
        "jwksUrl": "https://www.googleapis.com/oauth2/v3/certs",
        "clientId": "${GOOGLE_CLIENT_ID}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET}",
        "authorizationUrl": "https://accounts.google.com/o/oauth2/auth",
        "tokenUrl": "https://oauth2.googleapis.com/token",
        "userInfoUrl": "https://openidconnect.googleapis.com/v1/userinfo",
        "issuer": "https://accounts.google.com"
      }
    }
  ],
  "browserSecurityHeaders": {
    "contentSecurityPolicyReportOnly": "",
    "xContentTypeOptions": "nosniff",
    "xRobotsTag": "none",
    "xFrameOptions": "SAMEORIGIN",
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none';",
    "xXSSProtection": "1; mode=block",
    "strictTransportSecurity": "max-age=31536000; includeSubDomains"
  },
  "internationalizationEnabled": false,
  "webThemes": "",
  "adminThemes": "",
  "emailTheme": "",
  "smtpServer": {},
  "loginTheme": "keycloak",
  "accountTheme": "keycloak",
  "adminTheme": "keycloak"
}
