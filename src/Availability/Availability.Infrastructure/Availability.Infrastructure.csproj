<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <!-- La infraestructura implementa los contratos de Application y persiste las entidades de Domain. -->
  <ItemGroup>
    <ProjectReference Include="..\Availability.Application\Availability.Application.csproj" />
    <ProjectReference Include="..\Availability.Domain\Availability.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Alinea la versión de EF Core en ejecución con las herramientas de diseño. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>
</Project>
