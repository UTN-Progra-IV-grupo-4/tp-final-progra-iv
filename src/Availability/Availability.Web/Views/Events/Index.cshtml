@model EventsPageViewModel
@{
    ViewData["Title"] = "Eventos";
}

<div class="mb-4">
    <h1>Elegí tu evento</h1>
    <p class="text-muted">Consultá los asientos sin iniciar sesión.</p>
</div>
@if (Model.IsDemo)
{
    <div class="alert alert-info" role="status">Modo demostración: los eventos y la ocupación son datos de ejemplo.</div>
}
@if (Model.Events.Count == 0)
{
    <div class="alert alert-secondary">Todavía no hay eventos cargados.</div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model.Events)
        {
            <div class="col-md-6">
                <article class="card h-100 event-card">
                    <div class="card-body d-flex flex-column align-items-start">
                        <h2 class="h4">@item.Name</h2>
                        <p><time datetime="@item.StartsAt.ToString("O")">@item.StartsAt.ToString("dd/MM/yyyy HH:mm") UTC</time></p>
                        <p class="text-muted">@item.SeatCount asientos</p>
                        <a class="btn btn-primary mt-auto" asp-controller="Events" asp-action="Seats" asp-route-eventId="@item.Id">Ver asientos<span class="visually-hidden"> de @item.Name</span></a>
                    </div>
                </article>
            </div>
        }
    </div>
}
