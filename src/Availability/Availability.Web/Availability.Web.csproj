<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>tp-final-availability-local</UserSecretsId>
  </PropertyGroup>

  <!-- MVC utiliza los casos de uso expuestos por Application. -->
  <ItemGroup>
    <ProjectReference Include="..\Availability.Application\Availability.Application.csproj" />
    <!-- Solo el punto de composición (Program.cs) registra las implementaciones concretas. -->
    <ProjectReference Include="..\Availability.Infrastructure\Availability.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Necesario al ejecutar dotnet ef con Web como startup-project.
         PrivateAssets evita propagar las herramientas de diseño a otros proyectos. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
