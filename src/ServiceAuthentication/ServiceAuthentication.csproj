<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared client-credentials token acquisition (Keycloak) for service-to-service calls.
       Inbound validation stays in each API; this library only covers the outbound side. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Options, HttpClientFactory, logging and configuration all ship with the shared framework. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
