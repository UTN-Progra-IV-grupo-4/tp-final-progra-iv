{
  "ConnectionStrings": {
    "Payment": ""
  },
  "SimulatedGateway": {
    "Mode": "Approve",
    "SlowDelaySeconds": 15
  },
  "Charge": {
    "PendingTimeoutSeconds": 60,
    "SupportedCurrencies": [ "ARS" ],
    "MaxAmountCents": 100000000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true
      }
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  }
}
