# PostgreSQL admin bootstrap (single container)
POSTGRES_ADMIN_DB=postgres
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres_admin_local
POSTGRES_PORT=5432

# Service databases and users
AVAILABILITY_DB_NAME=availability
AVAILABILITY_DB_USER=availability_user
AVAILABILITY_DB_PASSWORD=availability_local
BOOKING_DB_NAME=booking
BOOKING_DB_USER=booking_user
BOOKING_DB_PASSWORD=booking_local
PAYMENT_DB_NAME=payment
PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=payment_local

# Azure Service Bus (primary broker). Obligatoria para el flujo completo:
# usar la cadena de conexion que entrega la catedra (topic grupo4-booking-topic, suscripcion booking).
# No subir este valor al repositorio.
AZURE_SERVICE_BUS_CONNECTION_STRING=

# RabbitMQ fallback (only with profile `rabbitmq`)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest_local
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Keycloak (valores solo para desarrollo local)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080
KEYCLOAK_AVAILABILITY_CLIENT_SECRET=availability_service_local_secret
KEYCLOAK_BOOKING_CLIENT_SECRET=booking_service_local_secret
KEYCLOAK_PAYMENT_CLIENT_SECRET=payment_service_local_secret

# Login con Google (opcional). Sin estos valores el login funciona igual con user1 / user2 (clave User123!).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=