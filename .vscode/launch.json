{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Availability.Web",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Availability/Availability.Web/bin/Debug/net10.0/Availability.Web.dll",
      "cwd": "${workspaceFolder}/src/Availability/Availability.Web",
      "env": { "ASPNETCORE_ENVIRONMENT": "Development" },
      "stopAtEntry": false
    },
    {
      "name": "Booking.Api",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Booking/Booking.Api/bin/Debug/net10.0/Booking.Api.dll",
      "cwd": "${workspaceFolder}/src/Booking/Booking.Api",
      "env": { "ASPNETCORE_ENVIRONMENT": "Development" },
      "stopAtEntry": false
    },
    {
      "name": "Payment.Grpc",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Payment/Payment.Grpc/bin/Debug/net10.0/Payment.Grpc.dll",
      "cwd": "${workspaceFolder}/src/Payment/Payment.Grpc",
      "env": { "ASPNETCORE_ENVIRONMENT": "Development" },
      "stopAtEntry": false
    },
    {
      "name": "Notifications.Worker",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Notifications/Notifications.Worker/bin/Debug/net10.0/Notifications.Worker.dll",
      "cwd": "${workspaceFolder}/src/Notifications/Notifications.Worker",
      "env": { "DOTNET_ENVIRONMENT": "Development" },
      "stopAtEntry": false
    }
  ],
  "compounds": [
    {
      "name": "All services",
      "configurations": [
        "Availability.Web",
        "Booking.Api",
        "Payment.Grpc",
        "Notifications.Worker"
      ],
      "stopAll": true
    }
  ]
}
